{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathregistry.com/x/docs/schemas/lock.schema.json",
  "title": "mreg-lock/0",
  "description": "mreg.lock (PROTOCOL_v0.md sections 9 and 11.4). Holds no token and no local path.",
  "type": "object",
  "required": [
    "schema",
    "registry",
    "generated_at",
    "toolchain",
    "lake_manifest_sha256",
    "packages"
  ],
  "properties": {
    "schema": {
      "const": "mreg-lock/0"
    },
    "registry": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "toolchain": {
      "type": "string"
    },
    "lake_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "all_modules": {
      "type": "boolean"
    },
    "train": {
      "type": [
        "string",
        "null"
      ]
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lake_name",
          "role",
          "commit",
          "from"
        ],
        "properties": {
          "lake_name": {
            "type": "string"
          },
          "role": {
            "enum": [
              "root",
              "dependency"
            ]
          },
          "commit": {
            "type": "string"
          },
          "from": {
            "enum": [
              "registry",
              "source",
              "mathlib-cache"
            ]
          },
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "build_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "resolve_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "signed": {
            "type": "boolean"
          },
          "shards": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "sha256",
                "bytes"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "bytes": {
                  "type": "integer"
                }
              }
            }
          },
          "source_changes": {
            "type": [
              "array",
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}

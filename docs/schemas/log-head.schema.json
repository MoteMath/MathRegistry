{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathregistry.com/x/docs/schemas/log-head.schema.json",
  "title": "mreg-log-head/1",
  "description": "/v1/log/head.json, signed over mreg-log-head-v1, n, sha256 each followed by a newline.",
  "type": "object",
  "required": [
    "schema",
    "n",
    "sha256",
    "time",
    "key_id",
    "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "mreg-log-head/1"
    },
    "n": {
      "type": "integer",
      "minimum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  }
}

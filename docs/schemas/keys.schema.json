{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathregistry.com/x/docs/schemas/keys.schema.json",
  "title": "mreg-keys/1",
  "description": "/v1/index/keys.json: the registry's public signing keys. key_id is the first 16 hex of the SHA-256 of the DER public key.",
  "type": "object",
  "required": [
    "schema",
    "keys"
  ],
  "properties": {
    "schema": {
      "const": "mreg-keys/1"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "alg",
          "public_key_pem",
          "state",
          "from"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "alg": {
            "const": "ECDSA_P256_SHA256"
          },
          "public_key_pem": {
            "type": "string",
            "pattern": "^-----BEGIN PUBLIC KEY-----\\n"
          },
          "state": {
            "enum": [
              "active",
              "retired"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "until": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          }
        }
      }
    }
  }
}

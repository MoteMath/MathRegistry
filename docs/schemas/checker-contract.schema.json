{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathregistry.com/x/docs/schemas/checker-contract.schema.json",
  "title": "mreg-checker-contract/1",
  "description": "The checker contract as data; generated from the json contract block of pages/checker-contract.md as contract.json.",
  "type": "object",
  "required": [
    "schema",
    "contract_version",
    "status",
    "written",
    "source_pins",
    "clauses"
  ],
  "properties": {
    "schema": {
      "const": "mreg-checker-contract/1"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^mreg-checker-contract/[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "written": {
      "type": "string"
    },
    "source_pins": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope",
          "title",
          "status",
          "gates",
          "code",
          "tests"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(K|B|V)[0-9]+[a-z]?$"
          },
          "scope": {
            "enum": [
              "contract",
              "beyond"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "enum": [
              "enforced",
              "not applicable",
              "not enforced"
            ]
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^G([1-9]|10)$"
            }
          },
          "code": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "file",
                "name",
                "assertion"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "assertion": {
                  "type": "string"
                }
              }
            }
          },
          "no_test": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$comment": "Cross-field rules checked by docs/check_docs.py: an enforced clause has code and either tests or no_test; a not applicable or not enforced clause has a reason."
}

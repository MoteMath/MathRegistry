{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mathregistry.com/x/docs/schemas/verify.schema.json",
  "title": "mreg-verify/1",
  "description": "reports/verify.json: the result of gates G1 to G10 for one build (PHASE2_CONTRACTS.md section 2). contract_version (checker contract 1.1.0 and later) names the contract the gates ran under; promote refuses a verify.json without it or older than its minimum. `unsafe` is the unsafe-declarations block (PHASE2_CONTRACTS.md section 10).",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "build_key",
    "commit",
    "toolchain",
    "platform",
    "modules",
    "index_sha256",
    "gates",
    "reports",
    "tools",
    "started",
    "finished"
  ],
  "properties": {
    "schema": {
      "const": "mreg-verify/1"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^mreg-checker-contract/[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "build_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "toolchain": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "modules": {
      "type": "integer",
      "minimum": 0
    },
    "index_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package": {
      "type": "string"
    },
    "gates": {
      "type": "object",
      "required": [
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6",
        "G7",
        "G8",
        "G9",
        "G10"
      ],
      "propertyNames": {
        "pattern": "^G([1-9]|10)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "pass",
              "flag",
              "fail",
              "not run"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "not run"
          ]
        },
        "schema": {
          "const": "mreg-graph/1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "unsafe": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "not run"
          ]
        },
        "schema": {
          "const": "mreg-unsafe/1"
        },
        "unsafe_count": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_with_lcproof_count": {
          "type": "integer",
          "minimum": 0
        },
        "partial_count": {
          "type": "integer",
          "minimum": 0
        },
        "safe_referring_to_unsafe_count": {
          "type": "integer",
          "minimum": 0
        },
        "first": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "timing": {
      "type": "object"
    },
    "reports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^reports/"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "started": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "finished": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
